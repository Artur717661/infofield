# Скопируйте в /opt/infofield/backend/.env и подставьте свои значения.
#
#   sudo -u infofield cp deploy/env/backend.env.example /opt/infofield/backend/.env
#   sudo -u infofield nano /opt/infofield/backend/.env
#   sudo chmod 600 /opt/infofield/backend/.env
#
# Файл читают и backend, и шлюз (через EnvironmentFile в systemd).
# В git он не попадает — .env в .gitignore.

# Ключ Google Gemini для разметки публикаций.
GEMINI_API_KEY=вставьте_свой_ключ

# Пароль базы сгенерируйте: openssl rand -base64 24
# Пользователь infofield, а не postgres — у него права только на свою базу.
DATABASE_URL=postgresql://infofield:СГЕНЕРИРОВАННЫЙ_ПАРОЛЬ@localhost/InfoField

# Что мониторим.
TG_CHANNEL_NAME=wearesiriusuniversity
VK_GROUP_NAME=siriusuniversity
