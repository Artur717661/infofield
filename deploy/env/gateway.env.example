# Скопируйте в /opt/infofield/gateway/.env
#
#   sudo -u infofield cp deploy/env/gateway.env.example /opt/infofield/gateway/.env
#   sudo chmod 600 /opt/infofield/gateway/.env
#
# DATABASE_URL здесь не нужен — он приходит из backend/.env.

# --- ОБЯЗАТЕЛЬНО для продакшена ---
# Куки сессии только по HTTPS. Оставить true.
COOKIE_SECURE=true

# С каких адресов принимаются POST-запросы (вход, админка).
# Должно совпадать с реальным доменом, иначе вход будет отдавать 403.
ALLOWED_ORIGINS=https://info-field.ru,https://www.info-field.ru

# Перед шлюзом стоит nginx, поэтому доверяем X-Forwarded-For,
# чтобы в журнале был настоящий IP пользователя, а не 127.0.0.1.
TRUST_PROXY_HEADERS=true

# --- сессии ---
# Выкидывать после 2 часов без активности и через 12 часов в любом случае.
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# --- защита от подбора пароля ---
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
ATTEMPT_WINDOW_MINUTES=15
MIN_PASSWORD_LENGTH=12

# --- кэш данных ---
# Сколько ответ backend'а считается свежим. 900 с = 15 минут.
# Меньше ставить не стоит: каждый промах кэша запускает парсер и Gemini.
CACHE_TTL_SECONDS=900
BACKEND_TIMEOUT_SECONDS=600
BACKEND_URL=http://127.0.0.1:8000
