[Unit]
Description=InfoField: обновлять данные каждые 6 часов

[Timer]
# Четыре раза в сутки. Чаще нет смысла: официальный канал вуза не публикует
# по несколько постов в час, а каждый проход расходует квоту Gemini.
OnCalendar=*-*-* 03,09,15,21:10:00
# Если сервер был выключен в момент запуска — догнать после включения.
Persistent=true
# Разброс до 5 минут, чтобы запуск не совпадал с другими задачами.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
